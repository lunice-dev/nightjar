    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/react-virtual": "^3.14.21",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
